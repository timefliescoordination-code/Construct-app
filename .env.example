# Copy to .env.local for local dev.
# Production (Hostinger vraconstruction.app): hPanel → Environment Variables.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jhnjlzbwfearhjmqybmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Vercel integration may use this name instead:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Required for admin user management (server-only; do not expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Recommended for Server Actions in production (build time + runtime on Hostinger).
# If omitted, a stable key is derived from NEXT_PUBLIC_SUPABASE_URL at build time.
# Generate your own: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-key

# Optional: stable deployment id for version skew protection during rolling deploys
# NEXT_DEPLOYMENT_ID=vraconstruction-20260823

# Optional: email redirect after signup
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Invoice OCR (server-only; required for line item extraction)
# OPENAI_API_KEY=sk-...
# INVOICE_OCR_MODEL=gpt-4o-mini

# Telegram expense bot (server-only unless noted)
# TELEGRAM_BOT_TOKEN=123456:ABC...   # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=random-long-string   # optional; verifies webhook requests
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotName   # without @
# Production site URL — required on Hostinger so redirects never use 0.0.0.0:3000
NEXT_PUBLIC_APP_URL=https://vraconstruction.app
# Alternative name (either works):
# NEXT_PUBLIC_SITE_URL=https://vraconstruction.app
