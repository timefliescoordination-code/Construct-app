# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Vercel integration may use this name instead:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Required for admin user management (server-only; do not expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email redirect after signup
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Invoice OCR (server-only; required for line item extraction)
# OPENAI_API_KEY=sk-...
# INVOICE_OCR_MODEL=gpt-4o-mini
